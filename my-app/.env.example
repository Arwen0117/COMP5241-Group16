# PostgreSQL connection string used by Prisma (CLI + app runtime).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comp5241?schema=public"

# --- Auth.js (next-auth v5) ---
# Secret used to encrypt the session JWT. Generate one with: npx auth secret
AUTH_SECRET="replace-me-with-a-random-secret"
# Google OAuth credentials (https://console.cloud.google.com/apis/credentials).
# While these are empty the app falls back to the mock session.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Force the mock session on/off. Omit to auto-detect (mock until the Google
# credentials above are filled in).
AUTH_MOCK="true"
